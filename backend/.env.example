# Local development only. Copy to backend/.env; never commit credentials.
HUGIN_MODE=live
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=hugin
DEX_API_KEY=
# Optional paid search. Only used when explicitly selected with a paid budget.
BRAVE_SEARCH_API_KEY=
# Exact public domains permitted for extraction (also allow them in cloud network settings).
HUGIN_SOURCE_HOSTS=
# Isolated Maigret database/detector. Install with scripts/install-collectors.sh.
HUGIN_MAIGRET_PYTHON=/workspace/.hugin-setup/maigret/bin/python
# Optional LinkedIn parser runtime. No passwords or cookies in environment variables.
HUGIN_LINKEDIN_PYTHON=/workspace/.hugin-setup/linkedin/bin/python
HUGIN_LINKEDIN_CHROMIUM=/usr/bin/chromium
# Owner-only Playwright storage-state JSON outside Git; missing session is explicit.
HUGIN_LINKEDIN_SESSION_FILE=
HUGIN_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Only for fixture mode. Separate from live data.
HUGIN_FIXTURE_STORE=.data/fixture-store.json

# Reviewed API Anything operations. No browser profile, cookies or API key needed.
HUGIN_API_ANYTHING_DIR=/workspace/.hugin-setup/api-anything/lib/node_modules/api-anything
HUGIN_API_ANYTHING_NODE=node
